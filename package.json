{
  "name": "openclaw-slack-block-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Send current-route Slack message-surface Block Kit through OpenClaw",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preplugin:build": "pnpm build",
    "plugin:build": "openclaw plugins build --root . --entry ./dist/index.js",
    "preplugin:metadata-check": "pnpm build",
    "plugin:metadata-check": "openclaw plugins build --check --root . --entry ./dist/index.js",
    "preplugin:validate": "pnpm build",
    "plugin:validate": "openclaw plugins validate --root . --entry ./dist/index.js",
    "preverify:completion": "pnpm build",
    "verify:completion": "node ./scripts/verify-completion-pipeline.mjs"
  },
  "dependencies": {
    "typebox": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
